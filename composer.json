{
    "name": "contenir/contenir-formbuilder",
    "description": "Framework-agnostic form-builder engine for Contenir CMS — runtime-editable form definitions, builder-form construction, server-side submission validation, and their storage with php-db on MySQL or SQLite.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "ext-fileinfo": "*",
        "laminas/laminas-filter": "^2.30",
        "laminas/laminas-form": "^3.20",
        "laminas/laminas-inputfilter": "^2.30",
        "laminas/laminas-session": "^2.16",
        "laminas/laminas-validator": "^2.50 || ^3.0",
        "peptolab/phpdb-migration": "^0.2",
        "php-db/phpdb": "^0.6.0",
        "psr/clock": "^1.0",
        "psr/log": "^1.0 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "contenir/contenir-qa-tools": "0.1.x-dev",
        "contenir/contenir-storage": "^2.2",
        "infection/infection": "^0.34.1",
        "php-db/phpdb-mysql": "0.5.x-dev",
        "php-db/phpdb-sqlite": "0.3.x-dev",
        "phpunit/phpunit": "^11.5.42"
    },
    "replace": {
        "contenir/formbuilder": "self.version"
    },
    "conflict": {
        "laminas/laminas-stdlib": "<3.21"
    },
    "suggest": {
        "contenir/contenir-storage": "Required for the file field type. Pass a Contenir\\Storage\\StorageManager into FormSubmissionService when uploads need to land on a configured storage profile."
    },
    "autoload": {
        "psr-4": {
            "Contenir\\FormBuilder\\": "src/",
            "Contenir\\FormBuilder\\Schema\\": "schema/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Contenir\\FormBuilder\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@static-analysis",
            "@test",
            "@test-integration",
            "@mutation-test"
        ],
        "cs-check": [
            "mago format --check",
            "mago lint"
        ],
        "cs-fix": [
            "mago format",
            "mago lint --fix"
        ],
        "static-analysis": "mago analyze",
        "test": "phpunit --colors=always --testsuite unit",
        "test-integration": [
            "phpunit --colors=always --testsuite integration",
            "@putenv CONTENIR_TEST_DB_PLATFORM=mysql",
            "phpunit --colors=always --testsuite integration"
        ],
        "test-coverage": "@php -d pcov.directory=. -d pcov.exclude=#/vendor/# vendor/bin/phpunit --colors=always --coverage-clover clover.xml",
        "mutation-test": "infection"
    },
    "config": {
        "platform": {
            "php": "8.3.99"
        },
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "extra": {
        "laminas": {
            "config-provider": "Contenir\\FormBuilder\\ConfigProvider"
        },
        "branch-alias": {
            "dev-main": "2.0.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
